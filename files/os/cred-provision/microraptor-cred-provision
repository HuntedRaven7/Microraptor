#!/bin/sh
# Provision the root account password as a systemd credential on first boot.
#
# Only runs when no password credential exists yet (see unit conditions).
# Tries to seal the hashed password to the platform TPM2 first; on machines
# without a usable TPM2 device it falls back to a plaintext (still hashed)
# entry in /etc/credstore/. systemd-sysusers then reads it back via the
# ImportCredential= drop-in when it creates the root account.
set -eu

PASSWD="${MICRORAPTOR_ROOT_PW:-bluefin}"
CMDLINE_PW="$(sed -n 's/.*microraptor\.rootpw=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null || true)"
[ -n "${CMDLINE_PW}" ] && PASSWD="${CMDLINE_PW}"

HASH="$(printf '%s' "${PASSWD}" | openssl passwd -6 -stdin 2>/dev/null || true)"
if [ -z "${HASH}" ]; then
  echo "microraptor-cred-provision: cannot hash password (openssl missing); leaving root locked" >&2
  exit 0
fi

HASH_FILE="$(mktemp /run/microraptor-roothash.XXXXXX)"
trap 'rm -f "${HASH_FILE}"' EXIT
printf '%s\n' "${HASH}" > "${HASH_FILE}"
chmod 0600 "${HASH_FILE}"

if systemd-creds encrypt \
    --with-key=tpm2 \
    --tpm2-device=auto \
    --name=passwd.hashed-password.root \
    "${HASH_FILE}" /etc/credstore.encrypted/passwd.hashed-password.root.cred \
    >/dev/null 2>&1; then
  chown 0:0 /etc/credstore.encrypted /etc/credstore.encrypted/passwd.hashed-password.root.cred
  chmod 0700 /etc/credstore.encrypted
  chmod 0600 /etc/credstore.encrypted/passwd.hashed-password.root.cred
  echo "microraptor-cred-provision: sealed root password credential to TPM2"
  exit 0
fi

# No TPM2 (or systemd-creds cannot use it): fall back to a plaintext
# credential store entry. The file carries only the password hash.
mkdir -p /etc/credstore
chown 0:0 /etc/credstore
chmod 0700 /etc/credstore
install -m 0600 "${HASH_FILE}" /etc/credstore/passwd.hashed-password.root
echo "microraptor-cred-provision: no TPM2 device; wrote plaintext credential store entry"