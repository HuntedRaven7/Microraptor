[Unit]
Description=Fetch the podman-quadlets sysext when installation did not seed it
ConditionPathExists=!/var/lib/podman-quadlets/quadlets.raw
Wants=network-online.target
After=network-online.target
Before=quadlets-first-boot.service

[Service]
Type=oneshot
Restart=on-failure
RestartSec=30s
ExecStart=/usr/bin/systemd-sysupdate --component=podman-quadlets update
