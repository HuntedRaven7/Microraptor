[Unit]
Description=Glance - Self-hosted dashboard
After=network-online.target
Wants=network-online.target

[Container]
Image={{GLANCE_IMAGE}}
ContainerName=glance
Publish=8080/tcp
Volume=glance-config:/app/config
Volume=glance-assets:/app/assets
Environment=TZ=%{CONTAINER_TZ:-UTC}
Exec=/usr/bin/podman systemd uproot %u /app/config:/app/config:Z /app/assets:/app/assets:Z
ExecStop=/usr/bin/podman stop glance
ExecStopPost=/usr/bin/podman rm glance
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
