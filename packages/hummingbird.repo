# Hummingbird's own rebuilt packages. Every RPM here carries a hum disttag,
# and it takes precedence over Fedora via priority, which is how Hummingbird
# composes its own buildroot (mock/mock.cfg in redhat/hummingbird/containers).
#
# Hummingbird already ships a working definition of this repository at
# /etc/yum.repos.d/hummingbird.repo, with its signing key already in the rpmdb.
# This file is the projectbluefin/utah spelling of the same repository, kept for
# reference and for the two things the base's copy does not say out loud:
# that gpgcheck is on, and that priority=10 is what makes a hum disttag win
# over the same package from Fedora.
#
# Do not install this over the base's copy. It is written for x86_64 and drops
# the $basearch stanza and the source repository, so doing so would break an
# arm64 build for no gain. The Containerfile only adds packages/fedora.repo.
#
# RPMs here are signed with Red Hat release key 2 (key ID 199e2f91fd431d51,
# fingerprint 567E 347A D004 4ADE 55BA 8A5F 199E 2F91 FD43 1D51).
[public-hummingbird-$basearch-rpms]
name=public-hummingbird-$basearch-rpms
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/$arch/
enabled=1
sslverify=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-hummingbird-release
priority=10
zchunk=false
