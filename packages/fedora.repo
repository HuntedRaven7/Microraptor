# Fedora 44 is the Hummingbird buildroot pairing. Hummingbird ships only its own
# repository, so every package the template installs from Fedora (just, gum,
# fzf, jq, flatpak) needs this file present at build time.
#
# 90-cleanup.sh flips both stanzas to enabled=0 before the image is committed,
# so an installed system resolves only Hummingbird's rebuilt RPMs. Enabling
# Fedora at runtime instead would let a user install a package that is not the
# Hummingbird-rebuilt one and pull in a buildroot this image was never tested
# against.
#
# zchunk=false is required, not a preference: Fedora stopped publishing the
# .xml.zck variants dnf5 asks for by default, and every metadata fetch 404s
# against the mirrors without it.
[fedora-44]
name=Fedora 44 - $basearch
baseurl=https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/$basearch/os/
enabled=1
metadata_expire=6h
repo_gpgcheck=0
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-44-primary
skip_if_unavailable=False
zchunk=false

[fedora-44-updates]
name=Fedora 44 - $basearch - Updates
baseurl=https://dl.fedoraproject.org/pub/fedora/linux/updates/44/Everything/$basearch/
enabled=1
metadata_expire=6h
repo_gpgcheck=0
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-44-primary
skip_if_unavailable=False
zchunk=false
