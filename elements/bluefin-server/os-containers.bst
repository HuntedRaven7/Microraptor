kind: import
description: |
  Install pre-configured Podman quadlet files into the target OS image.

  Quadlet versions are pinned in include/quadlets.yml. The actual quadlet
  files are generated by .github/scripts/update-quadlets.py and committed
  to files/os/containers/systemd/. This element installs them into
  /usr/lib/containers/systemd/ so systemd can generate and manage the
  container services automatically.

sources:
  - kind: local
    path: files/os/containers/systemd

config:
  target: /usr/lib/containers/systemd
