# Robin's Brewfile
#
# Copied from HuntedRaven7/dots@main:robin.Brewfile.
# Users install via: ujust install-default-apps
#
# Homebrew runs as the invoking user, not as root, so nothing here needs a
# privileged install. The `trusted: true` flags on taps and casks are carried
# over from the source unchanged: they tell Homebrew not to prompt for taps
# that cannot be audited by `brew tap`, which would otherwise hang a
# non-interactive first-boot run.

tap "anomalyco/tap", trusted: true
tap "colindean/fonts-nonfree", trusted: true
tap "ublue-os/experimental-tap", trusted: true
tap "ublue-os/tap", trusted: true
cask "jetbrains-toolbox-linux"
cask "visual-studio-code-linux"
vscode "ms-vscode-remote.remote-containers"
vscode "ms-vscode-remote.remote-ssh"
vscode "ms-azuretools.vscode-containers"
brew "atuin"
brew "bat"
brew "chezmoi"
brew "devcontainer"
brew "eza"
brew "fzf"
brew "gh"
brew "herdr"
brew "llama.cpp"
brew "mise"
brew "neovim"
brew "pi-coding-agent"
brew "podman-tui"
brew "ripgrep"
brew "starship"
brew "tealdeer"
brew "tmux"
brew "trash-cli"
brew "yq"
brew "zoxide"
brew "anomalyco/tap/opencode", trusted: true
cask "font-0xproto-nerd-font"
